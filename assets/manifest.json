{
	"format": 2,
	"sequence": [
		{
			"id": "tinyblocks/raw",
			"type": "image",
			"file": "tinyblocks.png",
			"description": "Loading tinyblocks.png"
		},
		{
			"id": "tiles/raw",
			"type": "crop-tiles",
			"input": "tinyblocks/raw",
			"tileWidth": 18,
			"tileHeight": 18,
			"columns": 10,
			"rows": 10,
			"description": "Cropping tinyblocks into tiles"
		},
		{
			"id": "tile-mapping",
			"type": "mapping",
			"file": "tile-mapping.json",
			"description": "Defining tile type mapping"
		},
		{
			"id": "tiles/typed",
			"type": "tile-type-mapping",
			"input": "tiles/raw",
			"mapping-id": "tile-mapping",
			"description": "Applying type mapping to tinyblocks tiles"
		},
		{
			"id": "tinyblocks/texture",
			"type": "create-texture",
			"input": "tinyblocks/raw",
			"description": "Creating texture from tinyblocks"
		},
		{
			"id": "hl-tinyblocks/raw",
			"type": "image",
			"file": "tinyblocks-hl.png",
			"description": "Loading highlighted tinyblocks-hl.png"
		},
		{
			"id": "hl-tiles/raw",
			"type": "crop-tiles",
			"input": "hl-tinyblocks/raw",
			"tileWidth": 18,
			"tileHeight": 18,
			"columns": 10,
			"rows": 10,
			"description": "Cropping highlighted tinyblocks into tiles"
		},
		{
			"id": "hl-tiles/typed",
			"type": "tile-type-mapping",
			"input": "hl-tiles/raw",
			"mapping-id": "tile-mapping",
			"description": "Applying type mapping to highlighted tiles"
		},
		{
			"id": "hl-tinyblocks/texture",
			"type": "create-texture",
			"input": "hl-tinyblocks/raw",
			"description": "Creating texture from highlighted tinyblocks"
		},
		{
			"id": "shadow/raw",
			"type": "image",
			"file": "shadow.png",
			"description": "Loading shadow.png"
		},
		{
			"id": "shadow/texture",
			"type": "create-texture",
			"input": "shadow/raw",
			"description": "Creating texture from shadow"
		},
		{
			"id": "monogram/font",
			"type": "bitmap-font",
			"file": "monogram-bitmap.json",
			"description": "Loading monogram bitmap font"
		},
		{
			"id": "tile-groups/default",
			"type": "tile-groups",
			"file": "tile-groups.json",
			"description": "Loading tile similarity groups"
		},
		{
			"id": "tilemap/easy",
			"type": "tilemap-preset",
			"file": "preset-easy.json",
			"description": "Defining easy mode tilemap preset"
		},
		{
			"id": "tilemap/medium",
			"type": "tilemap-preset",
			"file": "preset-medium.json",
			"description": "Defining medium mode tilemap preset"
		},
		{
			"id": "tilemap/hard",
			"type": "tilemap-preset",
			"file": "preset-hard.json",
			"description": "Defining hard mode tilemap preset"
		},
		{
			"id": "tilemap/extreme",
			"type": "tilemap-preset",
			"file": "preset-extreme.json",
			"description": "Defining extreme mode tilemap preset"
		}
	]
}
